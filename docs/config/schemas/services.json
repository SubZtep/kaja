{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "location": {
      "type": "object",
      "properties": {
        "serviceUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "serviceUrl"
      ]
    },
    "telegram": {
      "type": "object",
      "properties": {
        "allowedUserIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "allowedUserIds"
      ]
    },
    "api": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "baseUrl"
      ]
    }
  }
}
