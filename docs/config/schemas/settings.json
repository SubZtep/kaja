{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "stt": {
      "type": "object",
      "properties": {
        "speachesUrl": {
          "description": "Speaches AI server endpoint (speech-to-text)",
          "type": "string",
          "format": "uri"
        },
        "language": {
          "description": "Language hint for speech-to-text, e.g. 'en'",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tts": {
      "type": "object",
      "properties": {
        "speachesUrl": {
          "description": "Speaches AI server endpoint (text-to-speech)",
          "type": "string",
          "format": "uri"
        },
        "voice": {
          "description": "Voice name to use for text-to-speech",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "memory": {
      "type": "object",
      "properties": {
        "dbPath": {
          "description": "Absolute path to the SQLite memory database; omit to use the default XDG data location",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "preferences": {
      "description": "In-app preferences",
      "type": "object",
      "properties": {
        "thinking": {
          "description": "Show thinking indicator when the model is generating a response",
          "type": "boolean"
        },
        "sounds": {
          "description": "Enable sound effects",
          "type": "boolean"
        },
        "voice": {
          "description": "Enable voice output (text-to-speech)",
          "type": "boolean"
        },
        "locale": {
          "description": "Language for the chat and application",
          "type": "string",
          "enum": [
            "en-GB",
            "hu-HU",
            "nan-TW"
          ]
        },
        "hotkeyModifier": {
          "description": "Modifier key for the help/persona hotkeys (default: alt)",
          "type": "string",
          "enum": [
            "alt",
            "ctrl"
          ]
        }
      }
    }
  }
}
