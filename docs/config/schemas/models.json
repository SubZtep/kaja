{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "providers": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "base_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "base_url"
        ]
      }
    },
    "tasks": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "chat",
          "tts",
          "stt",
          "embedding",
          "image-generation",
          "rerank",
          "summarize"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "models": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "tasks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "chat",
                "tts",
                "stt",
                "embedding",
                "image-generation",
                "rerank",
                "summarize"
              ]
            }
          },
          "context_window": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "model",
          "provider",
          "tasks"
        ]
      }
    }
  }
}
