{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "providers": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "base_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "base_url"
        ]
      }
    },
    "models": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "type": "string",
            "enum": [
              "chat",
              "tts",
              "stt",
              "embedding",
              "image-generation",
              "rerank"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "model",
          "task",
          "provider"
        ]
      }
    }
  }
}
