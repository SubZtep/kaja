{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "object",
      "properties": {
        "chat": {
          "type": "string",
          "minLength": 1
        },
        "embedding": {
          "type": "string",
          "minLength": 1
        },
        "rerank": {
          "type": "string",
          "minLength": 1
        },
        "image-generation": {
          "type": "string",
          "minLength": 1
        },
        "text-to-speech": {
          "type": "string",
          "minLength": 1
        },
        "speech-to-text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "when": {
      "type": "string",
      "minLength": 1
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "top_p": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "max_tokens": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "frequency_penalty": {
      "type": "number",
      "minimum": -2,
      "maximum": 2
    },
    "presence_penalty": {
      "type": "number",
      "minimum": -2,
      "maximum": 2
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "label"
  ]
}
