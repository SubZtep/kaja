{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "models": {
      "type": "object",
      "properties": {
        "chat": {
          "description": "models.toml id to use for chat; omit to use the free hosted tier",
          "type": "string",
          "minLength": 1
        },
        "embedding": {
          "type": "string",
          "minLength": 1
        },
        "rerank": {
          "type": "string",
          "minLength": 1
        },
        "image-generation": {
          "type": "string",
          "minLength": 1
        },
        "text-to-speech": {
          "type": "string",
          "minLength": 1
        },
        "speech-to-text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "stt": {
      "type": "object",
      "properties": {
        "speachesUrl": {
          "description": "Speaches AI server endpoint (speech-to-text)",
          "type": "string",
          "format": "uri"
        },
        "language": {
          "description": "Language hint for speech-to-text, e.g. 'en'",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "tts": {
      "type": "object",
      "properties": {
        "speachesUrl": {
          "description": "Speaches AI server endpoint (text-to-speech)",
          "type": "string",
          "format": "uri"
        },
        "voice": {
          "description": "Voice name to use for text-to-speech",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "dbPath": {
          "description": "Absolute path to the SQLite memory database; omit to use the default XDG data location",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "preferences": {
      "description": "In-app preferences (slash menu)",
      "type": "object",
      "properties": {
        "thinking": {
          "description": "Show thinking indicator when the model is generating a response",
          "type": "boolean"
        },
        "sounds": {
          "description": "Enable sound effects",
          "type": "boolean"
        },
        "voice": {
          "description": "Enable voice output (text-to-speech)",
          "type": "boolean"
        },
        "language": {
          "description": "Language for the chat and application",
          "type": "string",
          "enum": [
            "en",
            "hu"
          ]
        },
        "persona": {
          "description": "Id of the persona to open with (see personas.toml)",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "models"
  ],
  "additionalProperties": false
}
