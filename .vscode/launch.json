{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "bun",
      "request": "launch",
      "name": "Debug API (apps/api)",
      "program": "${workspaceFolder}/apps/api/src/core/server.ts",
      "cwd": "${workspaceFolder}/apps/api",
      "watchMode": false,
      "stopOnEntry": false
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "Debug TUI --local",
      "program": "${workspaceFolder}/apps/tui/cli.ts",
      "args": [],
      "cwd": "${workspaceFolder}/apps/tui",
      "stopOnEntry": false
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "Debug TUI --cloud",
      "program": "${workspaceFolder}/apps/tui/cli.ts",
      "args": ["--cloud"],
      "cwd": "${workspaceFolder}/apps/tui",
      "stopOnEntry": false
    }
  ]
}
