{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!!docs", "!!pgdata"]
  },
  "formatter": {
    "useEditorconfig": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "domains": {
      "test": "recommended"
    },
    "rules": {
      "complexity": {
        "noUselessUndefinedInitialization": "off",
        "noUselessSwitchCase": "off",
        "noExcessiveNestedTestSuites": "on",
        "useArrayFind": "on"
      },
      "correctness": {
        "noUnreachable": "warn",
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn",
        "noUndeclaredDependencies": "on",
        "noPrivateImports": "on",
        "useJsonImportAttributes": "on"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noImplicitAnyLet": "off",
        "noTsIgnore": "off",
        "useIterableCallbackReturn": "off",
        "noDuplicateTestHooks": "on",
        "noExportsInTest": "on",
        "noFocusedTests": "error",
        "noSkippedTests": "on",
        "noDeprecatedImports": "on",
        "noImportCycles": "on"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useConsistentEnumValueType": "on"
      },
      "nursery": {
        "noIdenticalTestTitle": "on",
        "useTestHooksInOrder": "on",
        "noSelfImport": "on",
        "useAwaitThenable": "on",
        "useStringStartsEndsWith": "on",
        "useIncludes": "on",
        "useRegexpExec": "on",
        "useSortedClasses": "warn",
        "noUnsafePlusOperands": "on",
        "noUselessTypeConversion": "on",
        "noMeaninglessVoidOperator": "on",
        "useDisposables": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "lineWidth": 120,
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded",
      "trailingCommas": "none",
      "indentStyle": "space"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space"
    }
  }
}
