{
  "name": "kaja",
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "^1.4.1",
    "lefthook": "^2.1.10",
    "nitro": "npm:nitro-nightly@3.0.1-20260904-104602-c5177e92",
    "tombi": "^1.5.2",
    "typescript": "^7.0.2"
  },
  "description": "monorepo",
  "packageManager": "bun@1.4.2",
  "private": true,
  "scripts": {
    "dev": "bun run --parallel --filter '@kaja/api' --filter '@kaja/web' --filter '@kaja/widget' dev",
    "dev:api": "bun run --filter @kaja/api dev",
    "dev:cli": "bun run --env-file=apps/cli/.env apps/cli/cli.ts",
    "dev:cli:local": "bun run --env-file=apps/cli/.env apps/cli/cli.ts --local",
    "dev:web": "bun run --filter @kaja/web dev",
    "dev:widget": "bun run --filter @kaja/widget dev",
    "check:env": "bun scripts/env.ts --check",
    "generate:env": "bun scripts/env.ts",
    "generate:env-types": "bun scripts/env-types.ts",
    "generate:schemas": "bun run packages/schema/tombi/generate.ts",
    "lint": "biome check --config-path=. && tombi format --check && tombi lint",
    "lint:fix": "biome check --config-path=. --write --unsafe && tombi format && tombi lint --error-on-warnings",
    "typecheck": "set -e; for pkg in apps/* packages/*; do [ -f \"$pkg/tsconfig.json\" ] || continue; (cd \"$pkg\" && bunx tsc --noEmit); done"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
