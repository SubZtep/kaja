{
  "name": "kaja",
  "description": "monorepo",
  "packageManager": "bun@1.3.11",
  "private": true,
  "scripts": {
    "dev": "bun run --filter '!@kaja/cli' dev",
    "dev:cli": "bun run --env-file=apps/cli/.env apps/cli/cli.ts",
    "build": "bun run --filter @kaja/web build",
    "build:cli": "bun run --env-file=apps/cli/.env --filter @kaja/cli build:release",
    "lint": "biome check .",
    "lint:fix": "biome check . --write --unsafe",
    "test": "bun --env-file=apps/api/.env.example --env-file=apps/api/.env test"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "^1.3.13",
    "nitro": "npm:nitro-nightly@3.0.1-20260508-123613-d2e64906"
  }
}
