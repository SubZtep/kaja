{
  "name": "kaja",
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@faker-js/faker": "^10.6.0",
    "@types/bun": "^1.4.2",
    "lefthook": "^2.1.12",
    "nitro": "npm:nitro-nightly@3.0.1-20260908-105246-3b8980bb",
    "tombi": "^1.5.4",
    "typescript": "^7.0.2",
    "zod": "^4.6.1"
  },
  "description": "monorepo",
  "packageManager": "bun@1.4.2",
  "private": true,
  "scripts": {
    "dev": "bun run --parallel --filter '@kaja/api' --filter '@kaja/web' dev",
    "dev:api": "bun run --filter @kaja/api dev",
    "dev:tui": "bun run --env-file=apps/tui/.env apps/tui/cli.ts",
    "dev:web": "bun run --filter @kaja/web dev",
    "check:env": "bun scripts/env.ts --check",
    "generate:env": "bun scripts/env.ts",
    "generate:env-types": "bun scripts/env-types.ts",
    "generate:schemas": "bun run packages/schema/tombi/generate.ts",
    "seed:config": "bun run --filter @kaja/api seed:config",
    "lint": "biome check --config-path=. && tombi format --check && tombi lint",
    "lint:fix": "biome check --config-path=. --write --unsafe && tombi format && tombi lint --error-on-warnings",
    "typecheck": "set -e; for pkg in apps/* apps/*/* packages/*; do [ -f \"$pkg/tsconfig.json\" ] || continue; (cd \"$pkg\" && bunx tsc --noEmit); done"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
