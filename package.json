{
  "name": "kaja",
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "nitro": "npm:nitro-nightly@3.0.1-20260731-205209-52abde8a"
  },
  "description": "monorepo",
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "dev": "bun run --filter '@kaja/api' --filter '@kaja/web' dev",
    "dev:api": "bun run --filter @kaja/api dev",
    "dev:cli": "bun run --env-file=apps/cli/.env apps/cli/cli.tsx",
    "lint": "biome check --config-path=.",
    "lint:fix": "biome check --config-path=. --write --unsafe",
    "typecheck": "set -e; for pkg in apps/* packages/*; do [ -f \"$pkg/tsconfig.json\" ] || continue; (cd \"$pkg\" && bunx tsc --noEmit); done"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "kysely": "0.28.0"
  }
}
