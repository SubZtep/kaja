{
  "version": "1.0",
  "services": {
    "web": {
      "port": 3001,
      "image": "backend",
      "volumes": [
        {
          "name": "geoip-data",
          "destinationPath": "/usr/share/GeoIP"
        }
      ]
    },
    "hook:deploy:start:before": {
      "type": "command",
      "image": "migration",
      "command": "bun run db:push -- --force"
    },
    "geoipupdate-job": {
      "type": "cron",
      "schedule": "geoipupdate",
      "command": "46 20 * * 6,4"
    }
  },
  "images": {
    "backend": {
      "dockerfile": "apps/api/Dockerfile",
      "context": "."
    },
    "migration": {
      "dockerfile": "apps/api/Dockerfile.migrate",
      "context": "."
    }
  }
}
