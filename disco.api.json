{
  "version": "1.0",
  "services": {
    "web": {
      "port": 3001,
      "image": "backend",
      "volumes": [
        {
          "name": "geoip-data",
          "destinationPath": "/usr/share/GeoIP"
        }
      ]
    },
    "hook:deploy:start:before": {
      "type": "command",
      "image": "migration",
      "command": "sh -c 'ls -la && pwd && find . -name drizzle.config.ts'"
    }
  },
  "images": {
    "backend": {
      "dockerfile": "apps/api/Dockerfile",
      "context": "."
    },
    "migration": {
      "dockerfile": "apps/api/Dockerfile",
      "context": ".",
      "target": "builder"
    }
  }
}