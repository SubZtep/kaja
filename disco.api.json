{
  "version": "1.0",
  "services": {
    "web": {
      "port": 3001,
      "image": "backend",
      "volumes": [
        {
          "source": "/usr/share/GeoIP",
          "target": "/usr/share/GeoIP",
          "readOnly": true
        }
      ]
    },
    "cron": [
      {
        "schedule": "0 2 * * 3,6",
        "command": "geoipupdate -f /etc/GeoIP.conf -d /usr/share/GeoIP/",
        "description": "Update GeoIP database twice weekly (Wed/Sat at 2 AM)"
      }
    ]
  },
  "images": {
    "backend": {
      "dockerfile": "apps/api/Dockerfile",
      "context": "."
    }
  }
}
