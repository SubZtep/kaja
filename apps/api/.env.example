CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://testuser:testpass@localhost:5433/kaja
BETTER_AUTH_URL=http://localhost:3001
SMTP_HOST=localhost
SMTP_PORT=1025

# Logger Configuration
KAJA_APP_NAME=api
KAJA_LOG_LEVEL=trace
# KAJA_LOG_FILE=./logs/api.log     # Append JSON logs here instead of pretty-printing; unset KAJA_LOG_LEVEL = no log output at all

# Rate Limiting (enabled by default; auto-disabled under bun test)
# RATE_LIMIT_ENABLED=false              # Set false to disable global + auth limiters
# RATE_LIMIT_WINDOW_MS=900000           # Global rate limit window (15 minutes in ms)
# RATE_LIMIT_MAX=300                    # Max requests per window per IP
# AUTH_RATE_LIMIT_WINDOW_MS=900000      # Auth rate limit window (15 minutes in ms)
# AUTH_RATE_LIMIT_MAX=50                # Max auth requests per window per IP

# Security
# BETTER_AUTH_SECRET=                   # Generate with: openssl rand -base64 32

# Geo Service
GEO_SERVICE_URL=https://few-booklet-31770.ondis.co
GEO_SERVICE_API_KEY=your-api-key-here

# Config API (REQUIRED for /config/* — fail-closed: missing/empty denies all config routes)
# Also used by apps/openai to auth to the API and to authorize inbound proxy traffic.
# Generate with: openssl rand -base64 32
CONFIG_API_TOKEN=your-shared-secret-here
