# Rate Limiting (optional)
# RATE_LIMIT_WINDOW_MS=900000           # Global rate limit window (15 minutes in ms)
# RATE_LIMIT_MAX=100                    # Max requests per window per IP
# AUTH_RATE_LIMIT_WINDOW_MS=900000      # Auth rate limit window (15 minutes in ms)
# AUTH_RATE_LIMIT_MAX=50                # Max auth requests per window per IP (~3 req/min)

# Security
# BETTER_AUTH_SECRET=                   # Generate with: openssl rand -base64 32

