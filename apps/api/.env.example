# NODE_ENV=   # Node environment; "development" enables API docs and Better Auth's OpenAPI plugin
# PORT=3001   # Port the API server listens on
CORS_ORIGIN=   # Origin allowed for browser requests (also Better Auth's trusted origin and email callback base) (required)
DATABASE_URL=   # PostgreSQL connection string (required)
# BETTER_AUTH_URL=   # Public base URL of this API, used by Better Auth
# WEB_PUBLIC_URL=   # Public web app URL; falls back to CORS_ORIGIN for the device authorization verification link
# CROSS_PARENT_DOMAIN=   # Set when API and web share a parent domain (e.g. ondis.co) to enable cross-subdomain cookies
# SMTP_HOST=   # SMTP server hostname
# SMTP_PORT=1025   # SMTP server port
# SMTP_SECURE=   # Use TLS for the SMTP connection
# SMTP_USER=   # SMTP auth username
# SMTP_PASS=   # SMTP auth password (generate with: openssl rand -base64 32)
# CI=   # Set by the CI runner; skips SMTP verification on boot when present
# BUN_TEST=   # Set by the Bun test runner; disables rate limiting when present
# NASI_STUB_MODEL=   # When set, /nasi turns use a stub model instead of resolving a real provider (test/dev only)
# WEB_PROXY=http://user:pass@proxy.example.com:8080   # HTTP(S) proxy for cloud fetch_url egress; unset leaves fetch_url out of cloud turns entirely (generate with: openssl rand -base64 32)

# Security
# BETTER_AUTH_SECRET=   # Better Auth signing secret (generate with: openssl rand -base64 32)
# SSR_SECRET=   # Shared with the web's SSR_SECRET; the web's server-side calls send it with the visitor's IP so rate limits key on the visitor, not the web host (generate with: openssl rand -base64 32)

# Google Sign-in
# GOOGLE_CLIENT_ID=   # Google OAuth client id; Google sign-in is enabled when both id and secret are set
# GOOGLE_CLIENT_SECRET=   # Google OAuth client secret (redirect URI: <BETTER_AUTH_URL>/auth/callback/google) (generate with: openssl rand -base64 32)

# Config API
CONFIG_API_TOKEN=kaja   # Shared-secret bearer token for /config/* — fail-closed: missing/empty denies all config routes

# Rate Limiting
# RATE_LIMIT_ENABLED=   # Set false to disable global + auth + nasi/widget turn rate limiters
# RATE_LIMIT_WINDOW_MS=900000   # Global rate limit window (ms)
# RATE_LIMIT_MAX=1000   # Max requests per window per IP
# AUTH_RATE_LIMIT_WINDOW_MS=900000   # Auth rate limit window (ms)
# AUTH_RATE_LIMIT_MAX=2000   # Max auth requests per window per IP
# NASI_TURN_RATE_LIMIT_WINDOW_MS=600000   # /nasi/turn(/stream) rate limit window (ms)
# NASI_TURN_RATE_LIMIT_MAX=1000   # Max turns per window per user
# WIDGET_TURN_RATE_LIMIT_WINDOW_MS=600000   # /widget/turn rate limit window (ms)
# WIDGET_TURN_RATE_LIMIT_MAX=300   # Max turns per window per (widget key, IP) pair
# WIDGET_KEY_RATE_LIMIT_WINDOW_MS=600000   # /widget/turn spend-ceiling window (ms)
# WIDGET_KEY_RATE_LIMIT_MAX=3000   # Max turns per window per widget key, regardless of visitor/IP

# Marketplace
# USER_SECRET_KEY=   # Encrypts users' ability API keys (AES-256-GCM); unset turns key entry off and hides tools that need one (generate with: openssl rand -base64 32)
# ABILITY_KEYS=   # Server-wide ability API keys as comma-separated name=key pairs (e.g. brave-search=BSA...); every cloud user shares them, and a user's own key wins (generate with: openssl rand -base64 32)
# MARKETPLACE_REPO=SubZtep/kaja   # GitHub owner/repo whose marketplace/ folder the cloud ability catalog is synced from
# MARKETPLACE_REF=main   # Branch (or tag) of MARKETPLACE_REPO to sync

# MCP Sandbox
# SANDBOX_URL=http://localhost:3002   # Base URL of the MCP sandbox (apps/sandbox); with SANDBOX_SECRET it lets cloud turns use stdio MCP abilities
# SANDBOX_SECRET=   # Shared with the sandbox's SANDBOX_SECRET; signs the per-user tokens cloud turns connect with, and the admin dashboard's stats token (generate with: openssl rand -base64 32)

# Storage
STORAGE_BUCKET=kaja   # Object storage bucket for session and tool images
# STORAGE_REGION=fsn1   # Hetzner Object Storage location (fsn1, nbg1, hel1)
STORAGE_ENDPOINT=http://localhost:9000   # S3-compatible server to use instead of Hetzner (the compose storage service in dev, tests and CI)
# STORAGE_PUBLIC_ENDPOINT=   # STORAGE_ENDPOINT as clients reach it, for signed URLs; only when it differs (the compose API: storage:9000 vs localhost:9000)
STORAGE_ACCESS_KEY_ID=kaja   # Object storage access key
STORAGE_SECRET_ACCESS_KEY=kaja-dev-storage   # Object storage secret key

# Telegram
# TELEGRAM_BOT_TOKEN=   # BotFather token; when set, starts the always-on cloud Telegram bot (generate with: openssl rand -base64 32)
