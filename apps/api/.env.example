PORT=3001
CORS_ORIGIN=http://localhost:3000
# Optional: public web URL for device-auth verification (defaults to CORS_ORIGIN)
WEB_PUBLIC_URL=

# Optional: set base domain when apps live on subdomains (e.g. ondis.co)
CROSS_PARENT_DOMAIN=

DATABASE_URL=postgresql://testuser:testpass@localhost:5433/testdb
BETTER_AUTH_URL=http://localhost:3001

# Optional: Custom path to GeoIP database (defaults to system paths)
# GEOIP_DB_PATH=/usr/share/GeoIP/GeoLite2-City.mmdb

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Secrets — keep ONLY in .env (or host env in prod). Never commit real values.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

GEOIP_ACCOUNT_ID=
GEOIP_LICENSE_KEY=
GEOIP_DB_PATH=
