{
  "version": "1.0",
  "services": {
    "web": {
      "port": 3001,
      "image": "backend",
      "volumes": [
        {
          "name": "nasi-data",
          "destinationPath": "/var/lib/kaja"
        }
      ]
    },
    "hook:deploy:start:before": {
      "type": "command",
      "image": "backend",
      "command": "bun run migrate.js"
    }
  },
  "images": {
    "backend": {
      "dockerfile": "apps/api/Dockerfile",
      "context": "."
    }
  }
}
