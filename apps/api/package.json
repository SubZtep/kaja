{
  "name": "@kaja/api",
  "version": "0.9.1",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/core/server.ts",
    "build": "bun run build:widget && bun build --minify --target bun --outfile dist/server.js src/core/server.ts",
    "build:widget": "bun build --target=browser --format=iife --minify --outfile public/widget.js widgets/src/index.ts",
    "start": "bun run dist/server.js",
    "seed:config": "bun run scripts/seed-config.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@kaja/logger": "workspace:*",
    "@kaja/nasi": "workspace:*",
    "@kaja/schema": "workspace:*",
    "@kaja/shared": "workspace:*",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@scalar/hono-api-reference": "^0.12.1",
    "@sentry/bun": "10.74.0",
    "@sentry/hono": "^10.74.0",
    "better-auth": "^1.7.4",
    "grammy": "^1.46.0",
    "hono": "^4.13.7",
    "hono-rate-limiter": "^0.5.4",
    "nodemailer": "^10.0.3",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0"
  }
}
