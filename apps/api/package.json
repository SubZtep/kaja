{
  "name": "@kaja/api",
  "version": "0.22.5",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/core/server.ts",
    "build": "bun run build:widget && bun build --minify --target bun --external @aws-sdk/lib-storage --outfile dist/server.js src/core/server.ts",
    "build:widget": "bun build --target=browser --format=iife --minify --outfile public/widget.js widgets/src/index.ts",
    "start": "bun run dist/server.js",
    "seed:config": "bun run scripts/seed-config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-presigned-post": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@hono/zod-openapi": "^1.6.3",
    "@kaja/nasi": "workspace:*",
    "@kaja/schema": "workspace:*",
    "@kaja/shared": "workspace:*",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@scalar/hono-api-reference": "^0.12.10",
    "@sentry/bun": "^11.5.0",
    "@sentry/hono": "^11.5.0",
    "better-auth": "^1.7.7",
    "files-sdk": "^2.6.2",
    "grammy": "^1.46.0",
    "hono": "^4.13.13",
    "hono-rate-limiter": "^0.5.4",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0"
  }
}
