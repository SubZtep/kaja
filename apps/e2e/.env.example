# E2E_DATABASE_URL=postgresql://testuser:testpass@localhost:5433/kaja_e2e   # Postgres database the E2E stack runs on (dropped and rebuilt from the migrations every run); unset, the API's DATABASE_URL with _e2e appended to the database name
# E2E_API_PORT=3101   # Port the E2E API listens on, apart from bun dev's
# E2E_WEB_PORT=3100   # Port the E2E web app listens on, apart from bun dev's
# E2E_TELEGRAM_PORT=3102   # Port of the fake Telegram Bot API and chat window
# E2E_MAILDEV_URL=http://localhost:1080   # MailDev's web address, where sign-in codes are read
# E2E_STORAGE_BUCKET=kaja-e2e   # Bucket the E2E API stores images in
# E2E_LLM_API_KEY=   # API key of a hosted model provider the cloud turns use; set, it replaces the local llama.cpp below (generate with: openssl rand -base64 32)
# E2E_LLM_BASE_URL=https://api.fireworks.ai/inference/v1   # OpenAI-compatible base URL of the hosted provider (with E2E_LLM_API_KEY)
# E2E_LLM_MODEL=accounts/fireworks/models/minimax-m3   # Model name sent to the hosted provider (with E2E_LLM_API_KEY); a cheap one, since each run makes a few calls
# E2E_LLM_SUMMARIZE_MODEL=accounts/fireworks/models/glm-5p3-flash   # Model for context compaction at the hosted provider (with E2E_LLM_API_KEY)
# E2E_LLM_VISION_MODEL=accounts/fireworks/models/glm-5p3-flash   # Model that describes images at the hosted provider (with E2E_LLM_API_KEY)
# E2E_LLM_RERANK_MODEL=accounts/fireworks/models/qwen3-reranker-8b   # Reranker at the hosted provider (with E2E_LLM_API_KEY)
# E2E_LLAMA_URL=http://localhost:8080   # llama.cpp server the stack's cloud turns use; one already answering there is reused, else E2E_LLAMA_MODEL starts one
# E2E_LLAMA_BIN=/home/me/llama.cpp/build/bin/llama-server   # llama-server binary to start when none answers at E2E_LLAMA_URL; unset, llama-server on PATH
# E2E_LLAMA_MODEL=/home/me/Models/Ministral-3-3B-Reasoning-2512-Q4_K_M.gguf   # GGUF file the started llama-server loads (required when none answers at E2E_LLAMA_URL)
# E2E_LLAMA_ARGS=-ngl 0   # Extra llama-server flags (space separated), e.g. to keep it off a flaky GPU
# E2E_LLAMA_CONTEXT=16384   # Context size (tokens) of the started llama-server and of the model row the API reads
# E2E_BROWSER=/usr/bin/chromium   # Chromium or Chrome binary to drive; unset, the first of chromium, google-chrome and chrome on PATH
# E2E_HEADED=false   # Show the browser window while the scenarios run
# E2E_OUT_DIR=e2e-out   # Folder (under apps/e2e) the videos and logs are written to
