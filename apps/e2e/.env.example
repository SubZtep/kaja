# E2E_DATABASE_URL=postgresql://testuser:testpass@localhost:5433/kaja_e2e   # Postgres database the E2E stack runs on (dropped and rebuilt from the migrations every run); unset, the API's DATABASE_URL with _e2e appended to the database name
# E2E_API_PORT=3101   # Port the E2E API listens on, apart from bun dev's
# E2E_WEB_PORT=3100   # Port the E2E web app listens on, apart from bun dev's
# E2E_MAILDEV_URL=http://localhost:1080   # MailDev's web address, where sign-in codes are read
# E2E_STORAGE_BUCKET=kaja-e2e   # Bucket the E2E API stores images in
# E2E_BROWSER=/usr/bin/chromium   # Chromium or Chrome binary to drive; unset, the first of chromium, google-chrome and chrome on PATH
# E2E_HEADED=false   # Show the browser window while the scenarios run
# E2E_OUT_DIR=e2e-out   # Folder (under apps/e2e) the videos and logs are written to
