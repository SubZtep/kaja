{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "extends": "//",
  "linter": {
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "correctness": {
        "noChildrenProp": "off",
        "useExhaustiveDependencies": {
          "level": "warn",
          "fix": "none"
        },
        "noNestedComponentDefinitions": "on",
        "noReactPropAssignments": "on",
        "noRenderReturnValue": "on",
        "useJsxKeyInIterable": "on"
      },
      "suspicious": {
        "noArrayIndexKey": "on",
        "noDuplicatedSpreadProps": "on",
        "noReactForwardRef": "on",
        "noJsxLeakedDollar": "on",
        "noReactStringRefs": "on"
      },
      "style": {
        "useReactFunctionComponents": "on"
      },
      "nursery": {
        "noReactObjectTypeAsDefaultProp": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["lib/markdown/marked-terminal.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
