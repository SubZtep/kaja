# API_URL=   # Server-to-server API base URL — set by compose/disco to the container-network address (e.g. http://api:3001); takes precedence over VITE_API_URL when both are set
VITE_API_URL=http://localhost:3001   # Browser-facing API base URL, baked into the client bundle
# VITE_APP_URL=http://localhost:3000   # Public web app URL
# VITE_WIDGET_BARKOCHBA_KEY=   # Widget key pinned to the barkochba persona, used by the landing page's playable hero demo. Intentionally public — the Origin allowlist is the real gate, not key secrecy.
# VITE_WIDGET_CHAT_KEY=   # Second widget key, on a separate dedicated demo account, used by the landing page's embeddable chat widget script.
# SENTRY_AUTH_TOKEN=   # Sentry auth token used by the build-time Vite plugin to upload source maps (generate with: openssl rand -base64 32)

# Logging
# NODE_ENV=   # Selects @kaja/logger's node.ts destination: pretty-print in development, Axiom in production
# KAJA_APP_NAME=   # App name attached to every log line
# KAJA_LOG_LEVEL=   # Master on/off switch for logging - unset means no log output at all
# KAJA_LOG_FILE=   # Append JSON logs here instead of pretty-printing/Axiom, in any NODE_ENV
# AXIOM_DATASET=   # Axiom dataset to ship logs to (node, NODE_ENV=production, no KAJA_LOG_FILE)
# AXIOM_TOKEN=   # Axiom ingest token (node, NODE_ENV=production, no KAJA_LOG_FILE) (generate with: openssl rand -base64 32)
