# API_URL=   # Server-to-server API base URL — set by compose/disco to the container-network address (e.g. http://api:3001); takes precedence over VITE_API_URL when both are set
VITE_API_URL=http://localhost:3001   # Browser-facing API base URL, baked into the client bundle
# VITE_APP_URL=http://localhost:3000   # Public web app URL
# VITE_WIDGET_BARKOCHBA_KEY=   # Widget key pinned to the barkochba persona, used by the landing page's playable hero demo. Intentionally public — the Origin allowlist is the real gate, not key secrecy.
# VITE_WIDGET_CHAT_KEY=   # Second widget key, on a separate dedicated demo account, used by the landing page's embeddable chat widget script.
# VITE_UMAMI_WEBSITE_ID=00000000-0000-4000-0000-000000000000   # Umami analytics website id

# Logger Configuration
KAJA_APP_NAME=web
KAJA_LOG_LEVEL=trace
