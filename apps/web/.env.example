VITE_API_URL=http://localhost:3001
VITE_APP_URL=http://localhost:3000
# Widget key pinned to the `barkochba` persona (create via /widget), used by the landing page's
# playable hero demo. Intentionally public — same security model as any other widget key: the
# Origin allowlist is the real gate, not key secrecy — see apps/api/src/features/widget/auth.ts.
VITE_WIDGET_BARKOCHBA_KEY=
# Second widget key, on a separate dedicated demo account (auto-select persona, chat mode), used by
# the landing page's embeddable chat widget script — kept separate from VITE_WIDGET_BARKOCHBA_KEY to
# demonstrate two independent widget instances (and their separate per-account sqlite stores)
# coexisting on the same page. Not a throwaway: this account is a permanent fixture for the demo.
VITE_WIDGET_CHAT_KEY=
# VITE_UMAMI_WEBSITE_ID=00000000-0000-4000-0000-000000000000

# Logger Configuration
KAJA_APP_NAME=web
KAJA_LOG_LEVEL=trace
