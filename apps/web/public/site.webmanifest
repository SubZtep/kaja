{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "https://kaja.io",
  "lang": "en-GB",
  "dir": "ltr",
  "name": "Kaja.io",
  "name_localized": {
    "hu": { "value": "Kaja.io", "lang": "en" },
    "nan-TW": { "value": "Kaja.io", "lang": "en" }
  },
  "short_name": "Kaja",
  "short_name_localized": {
    "hu": { "value": "Kaja", "lang": "en" },
    "nan-TW": { "value": "Kaja", "lang": "en" }
  },
  "description": "Open-source AI agentic harness.",
  "description_localized": {
    "hu": "Nyílt forráskódú AI ügynöki eszköz.",
    "nan-TW": "開源 AI 代理工具。"
  },
  "categories": ["entertainment", "lifestyle", "productivity"],
  "start_url": "/",
  "display": "browser",
  "orientation": "any",
  "background_color": "#131711",
  "theme_color": "#9aa88f",
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "64x64 32x32 24x24 16x16",
      "type": "image/x-icon"
    },
    {
      "src": "/android-chrome-192x192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/android-chrome-512x512.png",
      "type": "image/png",
      "sizes": "512x512"
    }
  ]
}
