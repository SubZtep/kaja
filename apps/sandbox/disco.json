{
  "version": "1.0",
  "services": {
    "worker": {
      "image": "sandbox",
      "command": "bun sandbox.js",
      "volumes": [{ "name": "sandbox-state", "destinationPath": "/data" }]
    }
  },
  "images": {
    "sandbox": {
      "dockerfile": "apps/sandbox/Dockerfile",
      "context": "."
    }
  }
}
