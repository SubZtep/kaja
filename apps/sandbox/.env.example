# NODE_ENV=   # Node environment; "production" turns on Sentry
# KAJA_API_URL=http://localhost:3001   # Kaja API the sandbox connects out to (a WebSocket at /sandbox/connect; nothing connects in); unset, https://api.kaja.io with NODE_ENV=production (the image), else http://localhost:3001
# KAJA_SANDBOX_KEY=   # Your sandbox key from the web app's Sandbox page, linking the sandbox to your account; unset, it runs anonymously for everyone (generate with: openssl rand -base64 32)
# SANDBOX_NAME=   # A name shown for this sandbox
# SANDBOX_STATE_DIR=./.sandbox   # Folder the sandbox keeps its registration in, so a restart comes back as the same sandbox (mount a volume there in Docker)
# MARKETPLACE_DIR=../../marketplace   # Folder whose mcp/*.toml stdio manifests are the only servers the sandbox runs
# SANDBOX_OVERRIDES=overrides.json   # JSON file replacing a manifest's command/args for this host, e.g. a preinstalled binary and Chrome flags
# SANDBOX_CACHE_DIR=/home/node/.cache/mcp   # Folder the servers share for bun, uv and npm caches (and uv's Pythons), so a package bunx/uvx fetched stays fetched; unset, each start refetches into its throwaway HOME
# SANDBOX_IDLE_MS=600000   # How long an unused server process is kept warm before it's stopped (ms)
# SANDBOX_MAX_PROCESSES=8   # Most server processes running at once, over all users; each Chrome needs about 300-500 MB of RAM
# SANDBOX_ISOLATE_USERS=true   # Run each user's servers as their own Linux user (needs the sandbox to run as root, as in the image), so users can't read each other's files
# SANDBOX_EGRESS_PORT=3128   # Port of the 127.0.0.1 proxy that keeps the browsers to public addresses; must match overrides.json
# WEB_PROXY=http://user:pass@proxy.example.com:8080   # HTTP proxy the browsers' checked traffic goes out through (CONNECT to the checked IP, any port); unset connects directly (generate with: openssl rand -base64 32)
