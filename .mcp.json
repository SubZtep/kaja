{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "docker": {
      "type": "stdio",
      "command": "bunx",
      "args": ["-y", "mcp-server-docker"]
    },
    "filesystem": {
      "type": "stdio",
      "command": "bunx",
      "args": ["--bun", "@modelcontextprotocol/server-filesystem", "."]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "bunx",
      "args": ["--bun", "@playwright/mcp@latest"]
    },
    "postgres": {
      "type": "stdio",
      "command": "bunx",
      "args": [
        "--bun",
        "@modelcontextprotocol/server-postgres",
        "postgresql://testuser:testpass@localhost:5433/kaja"
      ]
    }
  }
}
