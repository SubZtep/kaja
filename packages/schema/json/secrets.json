{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "telegram": {
      "description": "The bot `kaja telegram` runs",
      "type": "object",
      "properties": {
        "bot_token": {
          "type": "string",
          "minLength": 1,
          "description": "The bot's token from @BotFather"
        },
        "owner_ids": {
          "default": [],
          "description": "Telegram user ids the bot answers; `kaja telegram` adds one when someone sends it the pairing code",
          "type": "array",
          "items": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "required": ["bot_token"]
    },
    "providers": {
      "default": {},
      "description": "Keys for models.toml's providers, keyed like its [providers.<name>] tables",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "api_key": {
                "type": "string",
                "minLength": 1,
                "description": "The provider's API key; Ollama needs one but ignores its value"
              }
            },
            "required": ["api_key"]
          },
          {
            "type": "object",
            "properties": {
              "api_key_env": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "description": "The environment variable holding the key, e.g. OPENAI_API_KEY: read when Kaja starts, never copied here"
              }
            },
            "required": ["api_key_env"]
          }
        ]
      }
    },
    "abilities": {
      "default": {},
      "description": "Keys for marketplace abilities, keyed by the ability's name, one for all its parts",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "api_key": {
            "type": "string",
            "minLength": 1,
            "description": "The ability's key; its manifest's `auth` says where it goes"
          }
        },
        "required": ["api_key"]
      }
    }
  }
}
